# StockWatch webes felulet: csak 127.0.0.1:8765-on figyel, kivulrol a Caddy (HTTPS) vagy
# SSH-alagut eri el. Jelszo kotelezo (python cli.py web-password).
# Telepites: deploy/install.sh masolja ide: /etc/systemd/system/
[Unit]
Description=StockWatch webes felulet
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=stockwatch
Group=stockwatch
WorkingDirectory=/opt/stockwatch
Environment=STOCKWATCH_ENV_FILE=/etc/stockwatch/stockwatch.env
Environment=HOME=/var/lib/stockwatch
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stockwatch/.venv/bin/python cli.py web --no-browser --behind-proxy
Restart=always
RestartSec=10

# Vedelem: a kod irasvedett, csak az adat-, konfig-, naplo- es titokmappa irhato
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/stockwatch/data /opt/stockwatch/logs /opt/stockwatch/config /etc/stockwatch /var/lib/stockwatch
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
