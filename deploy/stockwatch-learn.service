# StockWatch Gyakorlas (oktatasi kiadas): csak 127.0.0.1:8766-on figyel (a korabbi StockWatch a 8765-on),
# kivulrol a Caddy (HTTPS) vagy
# SSH-alagut eri el. Felhasznaloi fiokok: DATABASE_URL (Neon) es SMTP kell a titokfajlban.
# Telepites: deploy/install.sh masolja ide: /etc/systemd/system/
[Unit]
Description=StockWatch Gyakorlas (oktatasi kiadas)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=stockwatch-learn
Group=stockwatch-learn
WorkingDirectory=/opt/stockwatch-learn
Environment=STOCKWATCH_ENV_FILE=/etc/stockwatch-learn/stockwatch-learn.env
Environment=HOME=/var/lib/stockwatch-learn
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/stockwatch-learn/.venv/bin/python cli.py web --no-browser --behind-proxy --port 8766
Restart=always
RestartSec=10

# Vedelem: a kod irasvedett, csak az adat-, konfig-, naplo- es titokmappa irhato
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/stockwatch-learn/data /opt/stockwatch-learn/logs /opt/stockwatch-learn/config /etc/stockwatch-learn /var/lib/stockwatch-learn
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
