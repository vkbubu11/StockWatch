# Masold at .env nevre, es toltsd ki. A .env a .gitignore-ban van - a titkok soha nem kerulnek verziokezelesbe.

# Adatbazis (Neon Postgres): a Neon "Connection string" mezoje, Pooled connection bekapcsolva (-pooler host).
# Neon: projekt MARS, ag production, adatbazis StockWatch_Learning. Ellenorzes: python cli.py db migrate
DATABASE_URL=

# A szolgaltatas nyilvanos cime - az ellenorzo es jelszo-visszaallito levelek linkje (pl. https://gyakorlas.pelda.hu)
PUBLIC_URL=

# Tranzakcios e-mail (barmely szolgaltato SMTP-kapuja): 587 = STARTTLS, 465 = SSL
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Csak fejleszteshez: 1 = SMTP helyett a level (a linkkel) a naploba kerul
MAIL_TO_LOG=
