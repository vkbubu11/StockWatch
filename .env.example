# Masold at .env nevre, es toltsd ki.
# A .env fajl a .gitignore-ban van - a token soha nem kerul verziokezelesbe.
#
# Beszerzes:
#   1. Telegramon ird meg a @BotFather-nek: /newbot
#   2. Ird meg a sajat botodnak egy uzenetet
#   3. Nyisd meg: https://api.telegram.org/bot<TOKEN>/getUpdates
#      -> a valaszban a "chat":{"id":...} ertek kell
#   4. Ellenorzes: python cli.py test-alert

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord ertesites (ajanlott): NE kezzel ird, hanem:  python cli.py discord
# (szerveren: sudo stockwatch-cli discord) - ellenorzi, es probauzenetet kuld.
DISCORD_WEBHOOK_URL=

# Opcionalis: altalanos webhook (Google Chat, Slack).
# Google Chat: Space -> Apps & integrations -> Webhooks -> Add webhook -> URL masolasa
# Slack:       api.slack.com/apps -> Incoming Webhooks
# Discord:     Csatorna beallitasok -> Integraciok -> Webhookok
# Az URL maga a jelszo - soha ne tedd a settings.yaml-ba.
ALERT_WEBHOOK_URL=

# Opcionalis: Alpaca PAPER kereskedes (csak paper szamla engedelyezett).
# Legegyszerubb a webes felulet Beallitasok fulen megadni - az ide irja.
# Alpaca: Paper Trading -> API Keys -> Generate
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Webes felulet jelszava - NE kezzel ird, hanem:  python cli.py web-password
# (csak a scrypt hash kerul ide; szerveren / proxy mogott kotelezo)
STOCKWATCH_WEB_PASSWORD_HASH=
